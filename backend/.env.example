NODE_ENV=development
PORT=5000

# MongoDB — replace with your Atlas URI in production
MONGODB_URI=mongodb://localhost:27017/sarnconnect

# JWT — must be at least 32 random characters, keep secret
JWT_SECRET=change_this_to_a_random_32_char_string_in_production
JWT_EXPIRES_IN=7d

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# WhatsApp provider: "mock" for now, switch to "meta" when you have API access
WA_PROVIDER=mock

# Meta WhatsApp Cloud API — fill these when you get access
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_BUSINESS_ID=
META_WA_WEBHOOK_SECRET=

# File uploads
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=uploads

# App public URL (used for webhook registration with Meta later)
APP_URL=http://localhost:5000
